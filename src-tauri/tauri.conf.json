{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Writed.",
  "version": "1.2.0",
  "identifier": "com.dantemorrigan.writed",
  "build": {
    "frontendDist": "dist",
    "beforeBuildCommand": "npm run build && node src-tauri/stage-dist.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Writed.",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
